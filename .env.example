# Blossom Dreams — Environment Configuration
# Copy this file to `.env` for local use. In production (Render + Neon +
# Supabase) set these values directly in the platform's dashboard instead.

# Environment: development (local) or production (deployed).
ENVIRONMENT=production

# Security: required in production. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL — create a FREE Neon database (console.neon.tech), then copy the
# connection string. Neon free tier is persistent (it does not expire).
#   DATABASE_URL=postgresql://user:secret@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Local development default is SQLite (blossom_dreams.db) when unset.
DATABASE_URL=

# Public URL where the site is accessible (no trailing slash)
# e.g. https://blossom-dreams-lb.onrender.com
PUBLIC_BASE_URL=

# Allowed CORS Origins (comma separated, or * for public)
CORS_ORIGINS=*

# Upload storage. "supabase" = persistent FREE object storage (production);
# "local" = save to the filesystem (development only).
UPLOAD_STORAGE=supabase

# Supabase Storage (console.supabase.com -> new project -> Storage):
#   - Create a public bucket named `uploads`
#   - SUPABASE_URL   = https://<project-ref>.supabase.co
#   - SUPABASE_SERVICE_ROLE_KEY = the project's service_role secret key
#   - SUPABASE_STORAGE_BUCKET   = uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Initial Admin Credentials (used only if the admin user does not exist yet;
# change the password afterwards in Settings > Security).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@blossomdreams.com
ADMIN_PASSWORD=ChangeThisStrongPassword2025!
ADMIN_FULL_NAME=Blossom Admin